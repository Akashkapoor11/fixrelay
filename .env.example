# App binds to localhost by default; use 0.0.0.0 only behind a trusted proxy or Docker network.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
CLIENT_ORIGIN=http://localhost:5173
# Include dev origins and same-origin production URLs for the Express-served frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Hostnames accepted by the API. Add your deployment hostname explicitly; do not use a wildcard.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL is the only supported application database.
# For local Docker: postgresql://fixrelay:fixrelay_dev_only@localhost:5433/fixrelay
# For Render free-tier cloud: set PGSSL=true
DATABASE_URL=postgresql://fixrelay:fixrelay_dev_only@localhost:5433/fixrelay
PGSSL=false

# demo = deterministic evidence-first assistant; bedrock = live Strands agent with MCP tools.
# Set AI_PROVIDER=bedrock and configure AWS credentials below to enable live Bedrock inference.
AI_PROVIDER=demo

# AWS credentials — required only when AI_PROVIDER=bedrock.
# Create an IAM user with AmazonBedrockFullAccess and generate an access key.
# Never commit real credentials. Use environment variables or AWS profiles in production.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Set the region where your Bedrock model is available.
# Verified working region: ap-southeast-2 (Sydney), us-east-1 (N. Virginia)
AWS_REGION=us-east-1

# Bedrock model ID — must be available in your AWS_REGION.
# Verified: anthropic.claude-sonnet-4-5-20250929-v1:0 (ap-southeast-2)
# Alternative: anthropic.claude-3-5-sonnet-20241022-v2:0 (us-east-1)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Must be reachable from the Node server. In Docker, default is fine for same service.
MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp

# Approval tokens expire quickly; do not set this in production without a policy review.
APPROVAL_TTL_SECONDS=180
LOG_LEVEL=info
