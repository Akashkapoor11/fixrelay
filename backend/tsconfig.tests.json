{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "scripts/**/*.ts",
    "../open-source/MCP-Sentinel/src/**/*.ts",
    "../open-source/MCP-Sentinel/tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../dist"
  ]
}
